# Install as $LEARNLOOP_CONFIG_DIR/mobile.toml (default ~/.config/learnloop).
# Keep disabled until the vault is migrated, Serve is checked and the phone app is built
# (npm install && npm run build in apps/learnloop-mobile).
enabled = false
vault = "/ABSOLUTE/PATH/TO/VAULT"
hostname = "desktop.example-tailnet.ts.net"
port = 8765
owner_login = "owner@example.com"
max_upload_mb = 20
