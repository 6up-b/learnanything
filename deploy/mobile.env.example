# Install as ~/.config/learnloop/mobile.env, mode 0600.
# Literal KEY=value entries only. Do not put credentials in the repository.
# Capture alone needs no provider keys; the phone app grades here, so it needs the grading route's.
# If using a non-default config directory, set its ABSOLUTE path here:
# LEARNLOOP_CONFIG_DIR=/absolute/private/config/learnloop
