12px; padding: 0px;">▸ how did that feel</button></div></div></div></div></div><div style="border-top: 1px solid var(--border); padding: 6px 14px; display: flex; align-items: center; flex-wrap: wrap; column-gap: 20px; row-gap: 4px; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--dim); background: var(--bg); flex-shrink: 0; white-space: nowrap;"><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">drag</span><span>select text</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">ctrl+drag</span><span>select by drawing boxes</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">alt</span><span>clear selection</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">right-click</span><span>tag</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">alt+←</span><span>back</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">[ ]</span><span>tabs</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">\\</span><span>rail</span></span><span style="flex: 1 1 0%; min-width: 8px;"></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">^p</span><span>palette</span></span></div></div>"`;

exports[`an answer in the Reader is today's with reader_inquiry off as well (the flat rail) > ask rail after an answer lands 1`] = `"<div style="flex: 1 1 0%; min-height: 0; display: flex; flex-direction: column;"><div style="flex-shrink: 0; border-bottom: 1px solid var(--border); padding: 22px 32px; display: flex; flex-direction: column; gap: 8px;"><div style="display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;"><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.18em; color: var(--faint);">READER</span><button type="button" style="background: none; padding: 0px; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: var(--amber-link); text-decoration: underline; text-underline-offset: 2px; cursor: pointer;">← Library</button><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; color: var(--text-italic);">Matrices</span><div style="margin-left: auto; display: flex; align-items: center; gap: 8px;"><span style="color: var(--faint); font-size: 11px;">I want to</span><div class="term-select" style="position: relative; display: inline-block; width: 150px;"><div class="term-select-control" tabindex="0" role="combobox" aria-controls=":r:" aria-expanded="false" aria-haspopup="listbox" style="display: flex; align-items: center; gap: 8px; box-sizing: border-box; width: 100%; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; padding: 4px 12px; background: var(--input); border: 1px solid var(--border); color: var(--text); cursor: pointer; opacity: 1; pointer-events: auto; outline: none; user-select: none;"><span style="flex: 1 1 0%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">read closely</span><span style="color: var(--faint); font-size: 11px;">▾</span></div></div></div></div><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--dim);">Select a passage to ask about it, mark it, or make your own practice.</span><div style="display: flex; align-items: center; gap: 10px; min-width: 0;"><span style="color: var(--faint); font-size: 11px; flex-shrink: 0;">reading</span><div style="height: 3px; flex: 1 1 0%; max-width: 280px; background: var(--border); overflow: hidden;" aria-label="100% read"><div style="height: 100%; width: 100%; background: var(--amber);"></div></div><span style="color: var(--faint); font-size: 10px;">100%</span><button type="button" aria-pressed="true" style="margin-left: auto; border: 0px; background: transparent; color: var(--amber-link); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; cursor: pointer; padding: 0px;">quick checks on</button></div></div><div style="flex: 1 1 0%; min-height: 0; display: flex; overflow: hidden;"><div class="ll-scroll" style="flex: 1 1 0%; overflow-y: auto; padding: 18px 32px; display: flex; flex-direction: column; gap: 12px; position: relative;"><div data-span-id="span_symmetric_intro" data-extraction-id="ext_symmetric" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 15px; color: var(--amber); line-height: 1.7; border-left: 3px solid transparent; padding-left: 12px;"><div style="display: flex; align-items: center; gap: 8px;"></div><div>## Symmetric matrices and variance</div></div><div data-span-id="span_symmetric_prose" data-extraction-id="ext_symmetric" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--text); line-height: 1.7; border-left: 3px solid var(--amber); padding-left: 12px;"><div style="display: flex; align-items: center; gap: 8px;"></div><div>A real symmetric matrix $A = A^\\top$ admits an orthonormal eigenbasis. When choosing a decomposition for a variance problem, the **spectral decomposition** is preferred over a general SVD because the eigenvalues are the variances along principal axes.</div></div><div data-span-id="span_spectral_worked" data-extraction-id="ext_symmetric" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--text); line-height: 1.7; padding-left: 12px; border-left: 3px solid transparent;"><div style="display: flex; align-items: center; gap: 8px;"><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--pill-amber-fg); background: var(--pill-amber-bg); padding: 1px 8px; border-radius: 2px; white-space: nowrap;">suspect · crop_adjacent</span></div><div>Worked example: for $A = \\begin{bmatrix} 2 &amp; 1 \\\\ 1 &amp; 2 \\end{bmatrix}$, the eigenvalues $3$ and $1$ are the variances along the eigenvectors $(1,1)/\\sqrt2$ and $(1,-1)/\\sqrt2$.</div></div></div><div role="complementary" aria-label="Ask" style="width: 360px; height: 100%; min-height: 0; flex-shrink: 0; border-left: 1px solid var(--border); padding: 18px 20px; overflow-x: hidden; overflow-y: auto; overscroll-behavior-y: contain; scrollbar-gutter: stable;" class="ll-scroll"><div style="position: sticky; top: -18px; z-index: 8; margin: -18px -20px 16px; padding: 12px 20px 10px; background: var(--bg); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 6px;"><div style="display: flex; gap: 4px;"><button type="button" aria-pressed="false" aria-label="guide" style="flex: 1 1 0%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--border); color: var(--dim); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; padding: 6px 8px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.08em; background: transparent;">guide</button><button type="button" aria-pressed="true" aria-label="ask" style="flex: 1 1 0%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--border-focus); background: var(--wash-amber); color: var(--amber-link); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; padding: 6px 8px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.08em;">ask</button><button type="button" aria-pressed="false" aria-label="notes" style="flex: 1 1 0%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--border); background: transparent; color: var(--dim); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; padding: 6px 8px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.08em;">notes</button></div></div><div style="display: none;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 0px;">Reading guide</div></div><div style="display: none;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 0px;">Capture</div><div style="display: flex; flex-direction: column; gap: 8px;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; border-left: 1px solid var(--border); border-radius: 2px; padding: 14px 18px; background: transparent; cursor: default; display: flex; flex-direction: column; gap: 6px;"><div style="display: flex; align-items: center; gap: 8px;"><span style="color: var(--faint); font-size: 11px;">selected · 1 passage</span><button type="button" style="margin-left: auto; border: 0px; background: transparent; color: var(--faint); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; cursor: pointer;">edit</button><button type="button" style="border: 0px; background: transparent; color: var(--faint); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; cursor: pointer;">clear</button></div><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--text);">“A real symmetric matrix $A = A^\\top$ admits an orthonormal eigenbasis. When choosing a decomposition for a variance problem, the **spectral decomposition** is preferred over a general SVD because the eigenvalues are the variances along principal axes.”</span></div><textarea placeholder="your note (optional)…" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; background: var(--input); border: 1px solid var(--border); color: var(--text); padding: 8px; min-height: 54px; resize: vertical;"></textarea><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; border: 1px solid var(--amber); color: var(--amber); background: var(--wash-amber);">highlight</button><div style="display: flex; flex-direction: column; gap: 4px;"><span style="color: var(--faint); font-size: 10px; letter-spacing: 0.14em;">EXERCISES</span><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; border: 1px solid var(--amber); color: var(--amber); background: var(--wash-amber);">add exercise to practice</button><span data-meaning-label="" style="color: var(--dim); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px;">the exercise text stays verbatim — LearnLoop's model completes the answer, rubric, hints, and depth.</span></div><div style="display: flex; flex-direction: column; gap: 4px;"><span style="color: var(--faint); font-size: 10px; letter-spacing: 0.14em;">REQUEST · ANSWERED IN BACKGROUND</span><div style="display: flex; gap: 6px; flex-wrap: wrap;"><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">research this</button><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">worked example</button><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">explain differently</button><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">why this matters</button></div></div><div style="display: flex; flex-direction: column; gap: 4px;"><span style="color: var(--faint); font-size: 10px; letter-spacing: 0.14em;">REMEMBER LATER</span><div style="display: flex; gap: 6px; flex-wrap: wrap;"><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">test me later</button><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">help me remember</button><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">connect it</button></div></div><div style="display: flex; flex-direction: column; gap: 4px;"><span style="color: var(--faint); font-size: 10px; letter-spacing: 0.14em;">MARK</span><div style="display: flex; gap: 6px; flex-wrap: wrap;"><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">mark confusing</button><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">not worth remembering</button></div></div></div><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 22px;">Make your own practice</div><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: pointer; background: transparent; color: var(--dim);">write my own question</button><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 22px;">Annotations</div><span style="color: var(--faint); font-size: 12px;">no annotations yet.</span></div><div style="display: block;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 0px;">Ask</div><span data-meaning-label="" style="color: var(--dim); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; display: block; margin: 2px 0px 8px;">answers now, grounded in the selected passage · background requests live under notes</span><div style="display: flex; flex-direction: column; gap: 10px;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; border-left: 1px solid var(--border); border-radius: 2px; padding: 14px 18px; background: var(--elev); cursor: default; display: flex; flex-direction: column; gap: 4px;"><span style="color: var(--faint); font-size: 10px;">ASKING ABOUT YOUR SELECTION</span><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: var(--dim);"><div>A real symmetric matrix $A = A^\\top$ admits an orthonormal eigenbasis. When choosing a decomposition for a variance problem, the **spectral decomposition** is preferred over a general SVD because the eigenvalues are the variances along principal axes.</div></div></div><div style="display: flex; align-items: center; gap: 8px;"><span style="color: var(--faint); font-size: 11px;">mode</span><div class="term-select" style="position: relative; display: inline-block; width: 160px;"><div class="term-select-control" tabindex="0" role="combobox" aria-controls=":r:" aria-expanded="false" aria-haspopup="listbox" style="display: flex; align-items: center; gap: 8px; box-sizing: border-box; width: 100%; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; padding: 4px 12px; background: var(--input); border: 1px solid var(--border); color: var(--text); cursor: pointer; opacity: 1; pointer-events: auto; outline: none; user-select: none;"><span style="flex: 1 1 0%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">answer directly</span><span style="color: var(--faint); font-size: 11px;">▾</span></div></div></div><textarea placeholder="ask about this passage…" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; background: var(--input); border: 1px solid var(--border); color: var(--text); padding: 8px; min-height: 70px; resize: vertical;"></textarea><button type="button" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 6px 16px; border-radius: 2px; cursor: default; border: 1px solid var(--border); color: var(--faint); background: transparent;" disabled="">ask · ctrl+↵</button><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 22px;">Previous asks</div><div style="display: flex; align-items: center; gap: 8px;"><span style="color: var(--faint); font-size: 10px;">1 saved</span><button type="button" title="find in previous asks (ctrl+f)" aria-label="find in previous asks" style="margin-left: auto; width: 20px; height: 18px; border: 1px solid var(--border); background: transparent; color: var(--dim); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; cursor: pointer; padding: 0px;">⌕</button></div><div data-ask-id="a1"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; border-left: 3px solid var(--cyan); border-radius: 2px; padding: 14px 18px; background: transparent; cursor: default; display: flex; flex-direction: column; gap: 6px;"><button type="button" aria-expanded="true" aria-label="hide this ask" style="display: flex; align-items: baseline; gap: 7px; width: 100%; border: 0px; background: transparent; color: var(--text); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; padding: 0px; text-align: left; cursor: pointer;"><span style="color: var(--purple-text); flex-shrink: 0;">▼</span></button><div data-voice="learner" style="border-left: 2px solid var(--amber-mid); padding-left: 8px; display: flex; flex-direction: column; gap: 3px;"><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; color: var(--dim);"><span aria-hidden="true">›</span> your question</span><span style="position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px;">You wrote:</span><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--text); line-height: 1.6;"><div>why?</div></div></div><div style="display: flex; align-items: center; gap: 7px; flex-wrap: wrap;"><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--pill-cyan-fg); background: var(--pill-cyan-bg); padding: 1px 8px; border-radius: 2px; white-space: nowrap;">answer directly</span><button type="button" style="border: 0px; background: transparent; color: var(--faint); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; padding: 0px; cursor: pointer; text-decoration: underline; text-underline-offset: 2px;">show passage</button><span style="color: var(--faint); font-size: 9px; margin-left: auto;"><time></span></div><div data-voice="model" style="border-left: 1px dotted var(--purple-pill); padding-left: 8px; display: flex; flex-direction: column; gap: 3px;"><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; color: var(--purple-text);"><span aria-hidden="true">◇</span> LearnLoop's model</span><span style="position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px;">LearnLoop's model:</span><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--text); line-height: 1.6;"><div>Landed answer</div></div></div></div></div><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px;"><button type="button" style="background: transparent; color: var(--faint); cursor: pointer; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; padding: 0px;">▸ how did that feel</button></div></div></div></div></div><div style="border-top: 1px solid var(--border); padding: 6px 14px; display: flex; align-items: center; flex-wrap: wrap; column-gap: 20px; row-gap: 4px; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--dim); background: var(--bg); flex-shrink: 0; white-space: nowrap;"><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">drag</span><span>select text</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">ctrl+drag</span><span>select by drawing boxes</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">alt</span><span>clear selection</span></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">right-click</span><span>tag</span></span><span style="flex: 1 1 0%; min-width: 8px;"></span><span style="display: inline-flex; gap: 6px; flex-shrink: 0;"><span style="color: var(--text); font-weight: 600;">^p</span><span>palette</span></span></div></div>"`;

exports[`an answer in the Reader is today's with reader_tutor off (inquiry on) > ask rail after an answer lands 1`] = `"<div style="flex: 1 1 0%; min-height: 0; display: flex; flex-direction: column;"><div style="flex-shrink: 0; border-bottom: 1px solid var(--border); padding: 22px 32px; display: flex; flex-direction: column; gap: 8px;"><div style="display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;"><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.18em; color: var(--faint);">READER</span><button type="button" style="background: none; padding: 0px; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: var(--amber-link); text-decoration: underline; text-underline-offset: 2px; cursor: pointer;">← Library</button><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; color: var(--text-italic);">Matrices</span><div style="margin-left: auto; display: flex; align-items: center; gap: 8px;"><span style="color: var(--faint); font-size: 11px;">I want to</span><div class="term-select" style="position: relative; display: inline-block; width: 150px;"><div class="term-select-control" tabindex="0" role="combobox" aria-controls=":r:" aria-expanded="false" aria-haspopup="listbox" style="display: flex; align-items: center; gap: 8px; box-sizing: border-box; width: 100%; font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; padding: 4px 12px; background: var(--input); border: 1px solid var(--border); color: var(--text); cursor: pointer; opacity: 1; pointer-events: auto; outline: none; user-select: none;"><span style="flex: 1 1 0%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">read closely</span><span style="color: var(--faint); font-size: 11px;">▾</span></div></div></div></div><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--dim);">Select a passage to ask about it, mark it, or make your own practice.</span><div style="display: flex; align-items: center; gap: 10px; min-width: 0;"><span style="color: var(--faint); font-size: 11px; flex-shrink: 0;">reading</span><div style="height: 3px; flex: 1 1 0%; max-width: 280px; background: var(--border); overflow: hidden;" aria-label="100% read"><div style="height: 100%; width: 100%; background: var(--amber);"></div></div><span style="color: var(--faint); font-size: 10px;">100%</span><button type="button" aria-pressed="true" style="margin-left: auto; border: 0px; background: transparent; color: var(--amber-link); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; cursor: pointer; padding: 0px;">quick checks on</button></div></div><div style="flex: 1 1 0%; min-height: 0; display: flex; overflow: hidden;"><div role="main" aria-label="Matrices" class="ll-scroll" style="flex: 1 1 0%; overflow-y: auto; padding: 18px 32px; display: flex; flex-direction: column; gap: 12px; position: relative;"><div data-span-id="span_symmetric_intro" data-extraction-id="ext_symmetric" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 15px; color: var(--amber); line-height: 1.7; border-left: 3px solid transparent; padding-left: 12px;"><div style="display: flex; align-items: center; gap: 8px;"></div><div>## Symmetric matrices and variance</div></div><div data-span-id="span_symmetric_prose" data-extraction-id="ext_symmetric" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--text); line-height: 1.7; border-left: 3px solid var(--amber); padding-left: 12px;"><div style="display: flex; align-items: center; gap: 8px;"></div><div>A real symmetric matrix $A = A^\\top$ admits an orthonormal eigenbasis. When choosing a decomposition for a variance problem, the **spectral decomposition** is preferred over a general SVD because the eigenvalues are the variances along principal axes.</div></div><div data-span-id="span_spectral_worked" data-extraction-id="ext_symmetric" style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--text); line-height: 1.7; padding-left: 12px; border-left: 3px solid transparent;"><div style="display: flex; align-items: center; gap: 8px;"><span style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--pill-amber-fg); background: var(--pill-amber-bg); padding: 1px 8px; border-radius: 2px; white-space: nowrap;">suspect · crop_adjacent</span></div><div>Worked example: for $A = \\begin{bmatrix} 2 &amp; 1 \\\\ 1 &amp; 2 \\end{bmatrix}$, the eigenvalues $3$ and $1$ are the variances along the eigenvectors $(1,1)/\\sqrt2$ and $(1,-1)/\\sqrt2$.</div></div></div><div role="complementary" aria-label="Ask" style="width: 360px; height: 100%; min-height: 0; flex-shrink: 0; border-left: 1px solid var(--border); padding: 18px 20px; overflow-x: hidden; overflow-y: auto; overscroll-behavior-y: contain; scrollbar-gutter: stable;" class="ll-scroll"><div style="position: sticky; top: -18px; z-index: 8; margin: -18px -20px 16px; padding: 12px 20px 10px; background: var(--bg); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 6px;"><div style="display: flex; gap: 4px;"><button type="button" aria-pressed="false" aria-label="guide" style="flex: 1 1 0%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--border); color: var(--dim); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; padding: 6px 8px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.08em; background: transparent;">guide</button><button type="button" aria-pressed="true" aria-label="ask" style="flex: 1 1 0%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--border-focus); background: var(--wash-amber); color: var(--amber-link); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; padding: 6px 8px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.08em;">ask</button><button type="button" aria-pressed="false" aria-label="notes" style="flex: 1 1 0%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--border); background: transparent; color: var(--dim); font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; padding: 6px 8px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.08em;">notes</button></div></div><div style="display: none;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 0px;">Reading guide</div></div><div style="display: none;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; color: var(--amber); text-decoration: underline; text-underline-offset: 3px; margin-bottom: 14px; margin-top: 0px;">Capture</div><div style="display: flex; flex-direction: column; gap: 8px;"><div style="font-family: &quot;JetBrains Mono&quot;, &quot;Fira Code&quot;, ui-monospac