exports[`classic (ui.shell = 'classic') > keeps the base shell's nav byte for byte 1`] = `"<nav class="top-nav"><button class="active" type="button"><span>[1]</span>Start</button><button class="" type="button"><span>[2]</span>Today</button><button class="" type="button"><span>[3]</span>Graph</button><button class="" type="button"><span>[4]</span>Ingest</button><button class="" type="button"><span>[5]</span>Proposals</button><button class="" type="button"><span>[6]</span>Registry</button><button class="" type="button"><span>[7]</span>Library</button><button class="" type="button"><span>[9]</span>Reader</button><button class="" type="button"><span>[0]</span>Maintain</button><div class="nav-status"><button type="button" class="nav-add" title="Add a book, paper or video (Ctrl+O)">+ Add</button><span class="vault-menu-wrap"><span class="vault-path" role="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" title="/vault · click to switch vault">vault</span></span><button type="button" class="nav-settings health bad" title="open settings (Alt+S)"><span class="nav-settings-gear">⚙</span><span class="nav-settings-key">[Alt+S]</span></button></div></nav>"`;
