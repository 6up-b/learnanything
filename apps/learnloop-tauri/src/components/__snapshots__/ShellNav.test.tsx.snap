// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`classic (ui.shell = 'classic') > renders the base shell's ten-tab nav exactly 1`] = `"<nav class="top-nav"><button class="" type="button"><span>[1]</span>Start</button><button class="active" type="button"><span>[2]</span>Today</button><button class="" type="button"><span>[3]</span>Graph</button><button class="" type="button"><span>[4]</span>Ingest</button><button class="" type="button" aria-label="Proposals, 41 waiting"><span>[5]</span>Proposals<span class="nav-badge" style="color: var(--dim); font-size: 11px; margin-right: 0px; margin-left: 1px;" aria-hidden="true">·41</span></button><button class="" type="button"><span>[6]</span>Registry</button><button class="" type="button"><span>[7]</span>Library</button><button class="" type="button"><span>[9]</span>Reader</button><button class="" type="button" aria-label="Maintain, 3 waiting"><span>[0]</span>Maintain<span class="nav-badge" style="color: var(--dim); font-size: 11px; margin-right: 0px; margin-left: 1px;" aria-hidden="true">·3</span></button><div class="nav-status"><button type="button" class="nav-add" title="Add a book, paper or video (Ctrl+O)">+ Add</button><span class="vault-menu-wrap"><span class="vault-path" role="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" title="/home/u/LearnLoop · click to switch vault">LearnLoop</span></span><button type="button" class="nav-settings health ok" title="open settings (Alt+S)"><span class="nav-settings-gear">⚙</span><span class="nav-settings-key">[Alt+S]</span></button></div></nav>"`;
